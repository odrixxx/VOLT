# Это ОБРАЗЦОЧНЫЙ файл. Скопируй его в файл .env и вставь свой токен.
# .env.example — можно хранить в интернете, а .env — НИКОГДА!
TELEGRAM_BOT_TOKEN=123456789:AAABBBCCC_get_real_token_from_BotFather

# Юзернейм бота без @ (нужен для кнопки-ссылки «ЗАГРУЗИТЬ ЧЕК» в инструкции).
# Пример: BOT_USERNAME=volt_rewards_bot
BOT_USERNAME=your_bot

# СЕКРЕТНАЯ админ-панель (admin.py): ID Telegram-аккаунтов, которым бот будет
# незаметно пересылать ВСЕ сообщения пользователей и которые смогут писать
# им от имени бота (/write, /talk). Свой ID узнай у @userinfobot.
# Несколько админов — через запятую. БЕЗ этой строки панель молчит.
# Пример: ADMIN_IDS=111111111,222222222
ADMIN_IDS=
